{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pulse: a quarterly founder check-in. A platform concept for an impact-focused VC fund. Concept prototype, invented data.",
  "scripts": {
    "dev": "vite",
    "build": "npm run theme && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "theme": "node design/scripts/build-theme.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "build:single": "npm run theme && tsc -p tsconfig.json && vite build --config vite.single.config.ts && mv dist-single/index.html dist-single/pulse.html",
    "demo": "playwright test e2e/demo.spec.ts && node scripts/demo-video.mjs"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
