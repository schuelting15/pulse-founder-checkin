{
  "$about": "Design tokens for Pulse. design/scripts/build-theme.mjs writes them to src/styles/tokens.css; tailwind.config.ts maps its theme onto those variables.",
  "font": {
    "family": {
      "value": "Arimo, Arial, sans-serif",
      "note": "Arimo (OFL-1.1, @fontsource/arimo), self-hosted. Arimo comes first so every device renders the same face."
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700 }
  },
  "type": {
    "tiny":    { "size": "clamp(.6875rem, .6875rem + .02vw, .875rem)", "at1440": "11.29px", "lineHeight": 1.25, "letterSpacing": "0em", "weight": 400 },
    "small":   { "size": "clamp(.875rem, .875rem + .02vw, 1.25rem)", "at1440": "14.288px", "lineHeight": 1.25, "letterSpacing": "0em", "weight": 400 },
    "medium":  { "size": "clamp(1.425rem, 1.6625vw + .475rem, 8.55rem)", "at1440": "31.54px", "lineHeight": 1, "letterSpacing": "-0.01em", "weight": 400 },
    "large":   { "size": "clamp(1.8rem, 4.725vw, 8.1rem)", "at1440": "68.04px", "lineHeight": 1, "letterSpacing": "-0.01em", "weight": 700 },
    "display": { "size": "clamp(5rem, 14vw, 24rem)", "at1440": "201.6px", "lineHeight": 0.9, "letterSpacing": "-0.03em", "weight": 700 }
  },
  "color": {
    "background":      { "value": "#000000" },
    "backgroundAlt":   { "value": "#ffffff" },
    "text":            { "value": "#ffffff" },
    "textSecondary":   { "value": "rgba(255,255,255,0.5)" },
    "textOnLight":     { "value": "#000000" },
    "textSecondaryOnLight": { "value": "rgba(0,0,0,0.5)" },
    "hairline":        { "value": "rgba(255,255,255,0.25)" },
    "neutralLightest": { "value": "#eeeeee" },
    "neutralDarker":   { "value": "#222222" },
    "accent":          { "value": "#1378d1" },
    "inputText":       { "value": "#333333" }
  },
  "status": {
    "$note": "Fixed status scale; contrast vs #000: 6.26 / 11.45 / 4.37. Always icon + text label; the label stays in text colour.",
    "onTrack":  { "value": "#0ca30c", "label": "On track", "icon": "check" },
    "atRisk":   { "value": "#fab219", "label": "At risk", "icon": "alert" },
    "offTrack": { "value": "#d03b3b", "label": "Off track", "icon": "x" },
    "missing":  { "value": "rgba(255,255,255,0.5)", "label": "Missing", "icon": "dash" }
  },
  "chart": {
    "series": { "value": "#1378d1", "note": "Single series (actual); contrast 4.63 vs #000" },
    "target": { "value": "rgba(255,255,255,0.5)", "note": "Target path, 1px dashed" },
    "gridline": { "value": "rgba(255,255,255,0.25)", "note": "Same as the hairline" }
  },
  "focus": { "ring": "2px solid #1378d1", "offset": "2px" },
  "space": {
    "pageGutter": { "desktop": "2vw", "mobile": "4vw", "at1440": "28.8px" },
    "cellPadding": "16px",
    "blockGap": "64px",
    "heroPaddingTop": "200px",
    "buttonGap": "12px"
  },
  "radius": { "none": "0px", "dot": "99px", "note": "Everything is square. The only rounded elements are 4x4px dots marking grid intersections." },
  "border": {
    "hairline": "1px solid rgba(255,255,255,0.25)",
    "underline": "0 0 1px 0 solid #ffffff"
  },
  "shadow": { "none": "none", "note": "No box-shadows anywhere." },
  "layout": {
    "maxWidth": "100% (full-bleed); content sits on a 3-column grid of hairline-bordered cells (480px each at 1440)",
    "sectionHeader": "small white title + small grey subtitle at top-left, optional 'Label →' link at top-right",
    "numberCell": "small grey label top-left, value bottom-left in medium (31.54px/400) or large (68.04px/700) with grey caption"
  },
  "components": {
    "button":      { "background": "#ffffff", "color": "#000000", "padding": "10px 12px 6px", "radius": "0px", "fontSize": "small", "trailingIcon": "↗ or →", "hover": "no change" },
    "buttonLarge": { "background": "#ffffff", "color": "#000000", "padding": "16px 20px", "radius": "0px" },
    "linkArrow":   { "color": "#ffffff", "borderBottom": "1px solid #ffffff", "padding": "2px 0" },
    "chip":        { "border": "1px solid rgba(255,255,255,0.25)", "padding": "10px 12px 6px", "height": "36px", "radius": "0px", "selected": "white background, black text" },
    "gridDot":     { "size": "4px", "radius": "99px", "color": "#ffffff" },
    "input":       { "border": "1px solid rgba(255,255,255,0.25)", "padding": "8px 12px 8px 18px", "radius": "0px", "background": "transparent" },
    "navLink":     { "padding": "12px", "fontSize": "small", "hover": "no change" }
  }
}
